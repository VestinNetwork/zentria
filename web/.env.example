# WalletConnect project ID (get one at https://cloud.walletconnect.com)
# Required for production wallet connections via RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Per-chain deployed contract addresses. Update these after running
# `forge script Deploy.s.sol` against the target network.
